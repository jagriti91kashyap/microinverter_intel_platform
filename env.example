# =============================================================
# Microinverter Intelligence Platform — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in values:
#   cp env.example .env.local
#
# The app runs in DEMO MODE with only NEXTAUTH_SECRET set.
# Database, Redis, and AI keys are optional for local demo.
# =============================================================

# --- Required for auth (any random string works) ---
NEXTAUTH_SECRET="change-me-to-any-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Database (optional — app uses static TypeScript data by default) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/microinverter_platform"
POSTGRES_PASSWORD="postgres"

# --- Redis (optional — only needed for BullMQ background jobs) ---
REDIS_URL="redis://localhost:6379"
BULLMQ_REDIS_URL="redis://localhost:6379"

# --- AI Services (optional — AI pipeline features only) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Web Search (optional) ---
SERPAPI_KEY=""

# --- Application ---
NODE_ENV="development"
PORT=3000
MAX_FILE_SIZE="10485760"
